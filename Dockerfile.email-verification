ARG APP_IMAGE
FROM node:22-bookworm-slim AS verification-dependencies
WORKDIR /dependencies
COPY package.json package-lock.json ./
# Next bundles Azure Identity into server chunks. Raw verification scripts need
# the separately installed package; they cannot import a webpack chunk as an SDK.
RUN npm ci --omit=dev --ignore-scripts
FROM ${APP_IMAGE}
COPY --from=verification-dependencies --chown=nextjs:nextjs /dependencies/node_modules ./node_modules
COPY --chown=nextjs:nextjs lib/email/azure.ts ./scripts/azure/email-provider.ts
COPY --chown=nextjs:nextjs scripts/azure/verify-email.mjs ./scripts/azure/
COPY --chown=nextjs:nextjs scripts/azure/verify-email-outbox.mjs ./scripts/azure/
CMD ["node", "scripts/azure/verify-email.mjs"]
