# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Soyl Forms
SUPPORT_EMAIL=ryan.gomez@soyl.cloud

# Supabase (use current key naming from your Supabase project/docs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Isolated Azure auth proof. Leave disabled until dedicated-tenant acceptance passes.
# scripts/azure/prepare-identity.ps1 writes real secrets to ignored .env.azure.local.
ENTRA_AUTH_PROOF_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_APP_ORIGIN=http://localhost:3000
# At least 64 random characters; independent of all existing provider keys.
AUTH_SESSION_SECRET=
# Leave unset for production; isolated Android QA build uses com.soylai.forms.authproof.
NEXT_PUBLIC_NATIVE_APP_SCHEME=
# Non-owner runtime PostgreSQL credentials; TLS verification required outside localhost.
DATABASE_URL=
# Separate migration credentials; never used by the application process.
DATABASE_MIGRATION_URL=

# Cloudflare R2 (Phase 5)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Cloudflare Turnstile (Phase 8 hardening; optional in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Razorpay (Phase 6 — test mode first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=

# Email (Phase 4+ notifications)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# AI generation — provider switch + per-provider wiring
# AI_PROVIDER: anthropic | openai | azure-foundry | azure-openai
AI_PROVIDER=anthropic
# anthropic: official SDK; ANTHROPIC_API_KEY (or AI_API_KEY) + optional AI_MODEL
#   (default claude-opus-5) and AI_EFFORT (low|medium|high; default medium).
ANTHROPIC_API_KEY=
AI_API_KEY=
AI_MODEL=
# openai/azure-foundry: base URL of the OpenAI-compatible API
#   Azure AI Foundry serverless: https://<resource>.services.ai.azure.com/models
#   (AI_MODEL = deployment/model name, e.g. gpt-4o)
AI_BASE_URL=https://api.openai.com/v1
# azure-openai (classic) only:
#   AI_BASE_URL=https://<resource>.openai.azure.com, AI_MODEL = deployment name
AI_API_VERSION=2024-10-21

# Webhook secret encryption (32 random bytes, hex) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY=

# Scheduler guard for /api/cron/* (Cloudflare Cron Triggers or equivalent)
CRON_SECRET=

# Observability (production)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Product analytics (optional; never loaded on public /f/* routes)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin bootstrap — initial super-admin allow-list for setup only
SUPER_ADMIN_EMAILS=

# Rate limiting: set only behind a proxy that overwrites its client-IP header
# and blocks direct access to the origin. Values: cloudflare, vercel, custom.
# Without this, public requests safely share one anonymous rate-limit bucket.
TRUSTED_PROXY=
# Optional dedicated HMAC key; defaults to SUPABASE_SERVICE_ROLE_KEY.
RATE_LIMIT_SECRET=
